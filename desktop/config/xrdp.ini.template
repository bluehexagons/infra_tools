[Globals]
; xrdp.ini file version number
ini_version=1

; Enable bitmap caching and compression for performance
bitmap_cache=true
bitmap_compression=true
bulk_compression=true

; TCP buffer optimization
tcp_send_buffer_bytes=65536
tcp_recv_buffer_bytes=65536
tcp_nodelay=true
tcp_keepalive=true

; Security settings
; security_layer=tls forces TLS-encrypted RDP and disables the legacy
; standard-RDP/RC4 fallback that 'negotiate' permits. Modern clients
; (Remmina/FreeRDP, Windows mstsc) all support TLS; only very old or
; misconfigured clients require the negotiate downgrade path.
security_layer=tls
crypt_level=high
ssl_protocols=TLSv1.2, TLSv1.3
tls_ciphers=HIGH:!aNULL:!eNULL:!EXPORT:!DES:!MD5:!PSK:!RC4
certificate=/etc/xrdp/cert.pem
key_file=/etc/xrdp/key.pem

; Color depth and display settings
max_bpp=32

; Use classic RDP pipeline (non-egfx) for best compatibility
enable_gfx=false
blue=009cb5
grey=dedede
ls_top_window_bg_color=009cb5
ls_width=350
ls_height=430
ls_bg_color=dedede
ls_logo_filename=
ls_title=xRDP
ls_logo_x_pos=55
ls_logo_y_pos=50

; Session management
autorun=
use_fastpath=both
new_cursors=true
; Allow session reconnection and the explicitly listed channels below
allow_channels=true
allow_multimon=true
; Optimize for LAN performance (suitable for Remmina on local network)
max_idle_time=0
max_disc_time=0

; Fork a separate process per session for stability
fork=true

; Address to listen on (managed by --rdp-bind-address)
address={RDP_BIND_ADDRESS}
port=3389

[Logging]
LogFile=xrdp.log
LogLevel=INFO
EnableSyslog=true
SyslogLevel=INFO

[Channels]
; Dynamic virtual channels remain enabled for resize support. The coding-host
; baseline permits clipboard transfer, but blocks drive/device, printer,
; audio, RemoteApp, and video redirection unless explicitly requested.
rdpdr={RDP_DRIVE_REDIRECTION}
rdpsnd={RDP_AUDIO}
drdynvc=true
cliprdr={RDP_CLIPBOARD}
rail=false
xrdpvr=false

; Session types
[Xorg]
name=Xorg
lib=libxup.so
username=ask
password=ask
port=-1
code=20
